# GreenClose Environment Variables
# Copy this to .env and fill in real values

# Anthropic API — get at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Gmail SMTP — already configured in config/secrets.txt
# Uncomment to override:
# GMAIL_ADDRESS=slothbound@gmail.com
# GMAIL_APP_PASSWORD=cmzcygojcvdmhzro

# Dennis's email for daily updates
DENNIS_EMAIL=dvpetrashkan@gmail.com

# Base URL for quote page links
# Set to your domain once purchased, or leave as Vercel URL
BASE_URL=https://greenclose.onrender.com

# Stripe — get at stripe.com (Dashboard → Developers → API Keys)
# Both keys required to activate payments
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
# Webhook secret — get from Stripe Dashboard → Webhooks → your endpoint
STRIPE_WEBHOOK_SECRET=whsec_...
